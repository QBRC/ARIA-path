APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# This is for Http access use ex.(http://server.domain/ARIA-path/images/). 
# If the value is set then the backend api is going to use simpletiff instead of tifffile which supports more slides formats
IMAGE_PATH=

# API
# ModelSeeder uses ONE base URL and appends paths such as /deepzoom, /annotation, /copilot, /segment.
# For multi-service deployments on different ports, API_IP should point to a reverse proxy/API gateway
# that forwards those paths to the correct internal service ports.
#
# API_IP formats:
# 1) host + optional proxy prefix path
#    API_IP=api.example.org/aria-pathapi
# 2) direct ip:port (only when one exposed port already routes all required paths)
#    API_IP=127.0.0.1:8001
# 3) full URL (scheme here can override API_SCHEME)
#    API_IP=https://api.example.org/aria-pathapi
API_IP=
API_SCHEME=http
# If empty, ModelSeeder will auto-select ws for http and wss for https.
API_WS_SCHEME=

# Set true to build endpoints as API_IP + service-specific ports.
# Example: slide/deepzoom -> http://API_IP:API_PORT_DEEPZOOM/deepzoom/...
API_USE_SERVICE_PORTS=false
API_PORT_DEEPZOOM=
API_PORT_ANNOTATION=
API_PORT_NUCLEI=
API_PORT_COPILOT=
API_PORT_SEGMENT=
# Optional override for websocket stream. If empty, it falls back to API_PORT_ANNOTATION.
API_PORT_STREAM=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=datamanager
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"
BACKUP_NOTIFICATION_EMAIL=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
